+    def _top_up(self, planned: dict) -> None:
+        """frontier_lab diag (``top_up``): what the plan's own first week disposes of at a terminal, sent in place
+        through that terminal's valve into the grid's store, up to the room the store has left at the week's end."""
+        recs = getattr(self, "week_recs", None)
+        if not recs:
+            return
+        inst = self.model.inst
+        if not hasattr(self, "_top"):
+            self._top = []
+            for s in np.flatnonzero(self.valves):
+                e, k, _lane = inst.action_slots[int(s)]
+                tail, head = inst.edges[e].tail, inst.edges[e].head
+                if (tail, k) in inst.slot_index and (head, k) in inst.slot_index:
+                    at_grid = inst.slot_index[(head, k)]
+                    self._top.append((int(s), inst.slot_index[(tail, k)], at_grid, float(inst.stock_slots[at_grid].storage)))
+        disposal = np.asarray(recs[0].disposal, dtype=float)
+        room = {at_grid: storage - float(recs[0].stock[at_grid]) for _s, _at, at_grid, storage in self._top}
