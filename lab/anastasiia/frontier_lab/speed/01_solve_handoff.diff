+        # the program as flat arrays. HiGHS takes them as they are (``passModel``'s form with arrays copies each in one
+        # block); filling a ``HighsLp`` field by field converts the matrix entry by entry, 17 ms a program of Full
+        cost = np.ascontiguousarray(self.obj if C.cost is None else self.obj + C.cost, dtype=np.float64)
+        col_lo, col_up = np.ascontiguousarray(C.lb, dtype=np.float64), np.ascontiguousarray(C.ub, dtype=np.float64)
+        if inf != INF:  # HiGHS's infinity is IEEE's own in every build met so far
+            col_up = np.where(np.isinf(col_up), inf, col_up)
+            lo, hi = np.where(np.isinf(lo), -inf, lo), np.where(np.isinf(hi), inf, hi)
+        row_lo, row_up = np.ascontiguousarray(lo, dtype=np.float64), np.ascontiguousarray(hi, dtype=np.float64)
+        a_start, a_index = A.indptr.astype(np.int32, copy=False), A.indices.astype(np.int32, copy=False)
+        a_value = np.ascontiguousarray(A.data, dtype=np.float64)
+        whole = np.zeros(n_col, dtype=np.int32)  # every column continuous
+        model = [None]  # the same program as a ``HighsLp``, made only where the form with arrays is not there
+
+        def hand(h) -> None:
+            if model[0] is None:
+                try:
+                    h.passModel(n_col, n_row, len(a_value), int(hs.MatrixFormat.kColwise), int(hs.ObjSense.kMinimize),
+                                float(self.offset), cost, col_lo, col_up, row_lo, row_up, a_start, a_index, a_value, whole)
+                    return
+                except TypeError:  # an interface without that form
+                    lp = hs.HighsLp()
+                    lp.num_col_, lp.num_row_ = n_col, n_row
+                    lp.col_cost_, lp.col_lower_, lp.col_upper_ = cost, col_lo, col_up
+                    lp.row_lower_, lp.row_upper_ = row_lo, row_up
+                    lp.offset_ = float(self.offset)
+                    lp.a_matrix_.format_ = hs.MatrixFormat.kColwise
+                    lp.a_matrix_.num_col_, lp.a_matrix_.num_row_ = n_col, n_row
+                    lp.a_matrix_.start_, lp.a_matrix_.index_, lp.a_matrix_.value_ = a_start, a_index, a_value
+                    model[0] = lp
+            h.passModel(model[0])
