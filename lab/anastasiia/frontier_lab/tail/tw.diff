+    def _chip_pools(self, end: tuple, room: dict, after: float) -> None:
+        """tail lab (frontier_lab's ``chip_room``, here with the episode's end): the capped end credit for the chips
+        of a plant, one pool a (plant, packaged chip).
+
+        A pool is what a plant holds of a chip at the window's end: the packaged chips in its store, the raw ones in
+        its store and on the way to it, and what it is packaging. It is worth the chip's end value up to what the
+        plant's exits carry, as the window's last week has them (a prohibited exit and an exit into a market that
+        does not want the chip carry nothing), in ``weeks`` weeks and no more than in the weeks of the episode past
+        the window; above that, ``floor`` of the value. ``top_scale`` and ``top_weeks``: when the episode ends within
+        ``top_weeks`` weeks of the window's end, a pool pays ``top_scale`` times the end value: nothing made after
+        the window can then be sold, so what the exits can still carry of the pool is sold, at the whole penalty.
+        """
+        inst, T, nc = self.inst, self.T, self.nc
+        end_k, weeks, floor = end[1], float(room.get("weeks", 1e9)), float(room.get("floor", 0.0))
+        boost = float(room.get("top_scale", 1.0)) if after <= float(room.get("top_weeks", 0)) else 1.0
+        u, Z = np.asarray(self.marks.u[T - 1], dtype=float), np.asarray(self.marks.prohibited[T - 1])
+        sinks = {d.node for d in inst.demands}
+        wanted = {(d.node, d.k) for di, d in enumerate(inst.demands) if float(self.marks.demand[T - 1][di]) > 0}
+        for o in inst.osats:
+            for raw, packed in sorted(inst.nodes[o].osat.packages.items()):
+                if end_k[packed] <= 0:
+                    continue
+                carry = sum(float(u[e]) for e in inst.out_edges[o]
+                            if packed in inst.edges[e].K and not Z[e, packed]
+                            and (inst.edges[e].head not in sinks or (inst.edges[e].head, packed) in wanted))  # fmt: skip
+                self.chip_pool[(o, raw)] = self.chip_pool[(o, packed)] = len(self.pools)
+                self.pools.append({"k": packed, "value": (boost - floor) * float(end_k[packed]), "floor": floor,
+                                   "cap": min(weeks, after) * carry, "cols": []})  # fmt: skip
