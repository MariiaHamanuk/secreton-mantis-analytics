+    def _reaches(self, past: float, node: int, k: int, arriving: bool = False) -> float:
+        """tail lab: 1 when a unit of ``k`` that is in the stock of ``node`` (``arriving``: that arrives there)
+        ``past`` weeks after the window's last can be sold before the episode ends, else 0 (1 without "reach")."""
+        if self.reach is None:
+            return 1.0
+        lead = self.reach[1 if arriving else 0].get((node, k))
+        return 1.0 if lead is not None and past + lead <= self.reach[2] else 0.0
