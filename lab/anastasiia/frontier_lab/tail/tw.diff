+            elif key[0] == "xi" and (inst.osats[key[1]], key[2]) in self.chip_pool:
+                o, tau = inst.osats[key[1]], inst.nodes[inst.osats[key[1]]].osat.tau
+                cols = self.pools[self.chip_pool[(o, key[2])]]["cols"]
+                cols.extend(t * nc + j for t in range(max(0, T - tau), T) if self._reaches(t + 1 + tau - T, o, key[2]))
