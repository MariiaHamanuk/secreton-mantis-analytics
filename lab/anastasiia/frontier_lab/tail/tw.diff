+    def _leads(self) -> tuple[dict, dict]:
+        """tail lab: weeks from where a unit is to its sale by the shortest way, by (node, commodity): from a stock as
+        a week ends, and from an arrival in a week. As the simulator moves things: a stock is dispatched the week
+        after and arrives an edge's lead later; a fab and a plant start on what arrives the same week and their
+        output is in stock a process time later; a strait may pass an arrival on the same week; a market sells an
+        arrival the same week. A (node, commodity) with no way to a sale is left out."""
+        inst = self.inst
+        chk = set(inst.chokepoints)
+        made = {(f, inst.nodes[f].fab.input): (inst.nodes[f].fab.tau, inst.nodes[f].fab.product) for f in inst.fabs}
+        for o in inst.osats:
+            for raw, packed in inst.nodes[o].osat.packages.items():
+                made[(o, raw)] = (inst.nodes[o].osat.tau, packed)
+        stock, arrive = {}, {}
+        for d in inst.demands:
+            stock[(d.node, d.k)], arrive[(d.node, d.k)] = 1.0, 0.0
+        markets = set(arrive)
+        keys = {(inst.edges[e].tail, k) for e in range(len(inst.edges)) for k in inst.edges[e].K} | set(made)
+        for _ in range(len(inst.nodes)):  # the shortest ways settle in at most as many rounds as there are nodes
+            changed = False
+            for n, k in keys:
+                if (n, k) in markets:
+                    continue
+                if (n, k) in made:
+                    tau, out = made[(n, k)]
+                    a = tau + stock.get((n, out), INF)
+                    s_ = 1.0 + a
+                else:
+                    a = min((inst.edges[e].tau + arrive.get((inst.edges[e].head, k), INF)
+                             for e in inst.out_edges[n] if k in inst.edges[e].K), default=INF)
+                    s_ = 1.0 + a
+                    if n not in chk:  # it enters the stock and leaves the week after
+                        a = s_
+                if a < arrive.get((n, k), INF) or s_ < stock.get((n, k), INF):
+                    arrive[(n, k)], stock[(n, k)], changed = min(a, arrive.get((n, k), INF)), min(s_, stock.get((n, k), INF)), True
+            if not changed:
+                break
+        return ({key: v for key, v in stock.items() if v < INF}, {key: v for key, v in arrive.items() if v < INF})
