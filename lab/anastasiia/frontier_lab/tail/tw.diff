+                    self.pools[self.chip_pool[(sl.node, sl.k)]]["cols"].append((T - 1) * nc + j)
+            elif key[0] == "x" and (inst.edges[key[1]].head, key[2]) in self.chip_pool:
+                head, tau = inst.edges[key[1]].head, inst.edges[key[1]].tau
